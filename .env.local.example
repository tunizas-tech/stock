# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 gitignore 대상.
# 아무것도 채우지 않아도 앱은 동작한다(localStorage + mock 시세).

# ── 시세 · 펀더멘털 (서버 전용 — NEXT_PUBLIC_ 접두사 금지) ──────────────
# KIS Developers(한국투자증권). 국내 주식·지수 시세, 기간별시세(일/주/월봉),
# 해외 주식·지수 시세까지 담당. 백테스트용 과거 일봉도 여기서 받는다.
# 발급: https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 키를 쓸 때만: https://openapivts.koreainvestment.com:29443 (비우면 실전 서버)
# 주의: 수급(투자자별 매매동향) 등 일부 API는 모의투자에서 제공되지 않을 수 있다.
KIS_BASE_URL=

# Finnhub — 미국 종목 시세 폴백. 없으면 mock으로 떨어진다.
# 발급: https://finnhub.io/dashboard
FINNHUB_API_KEY=

# ── 서버 인증 (Coolify 등에 올릴 때만) ─────────────────────────────────
# 둘 다 채우면 앱 전체에 Basic Auth가 걸린다. 비워두면 로컬처럼 열려 있다.
# 관측소·매매일지가 인터넷에 노출되므로 서버에서는 반드시 채울 것.
APP_USER=
APP_PASS=

# ── 뉴스 대시보드(/news) ───────────────────────────────────────────────
# 네이버 검색 API. 발급: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 저장소 (Coolify Postgres) ────────────────────────────────────────────
# 뉴스·매매일지·보유종목·관심종목이 함께 쓰는 단일 Postgres. 채우면 네 곳 모두
# localStorage 대신 여기 영속 저장(비워두면 뉴스는 비활성, 매매일지·보유·관심종목은 localStorage).
# 앱을 배포하기 전에 아래 세 스키마를 이 순서로 1회 적용할 것:
# db/news-schema.sql → db/journal-schema.sql → db/portfolio-schema.sql
# 예: postgresql://user:password@host:5432/dbname
DATABASE_URL=
